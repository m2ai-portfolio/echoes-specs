    Node1:
      DependencyIndex: 1
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 tint;
            output_vec4 result;
            
            // Echoes candidate ghost: faint fill, fresnel rim, and bright bounding-box edges.
            void main()
            {
            	vec3 N = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 P = system.getSurfacePositionWorldSpace();
            	vec3 V = normalize(system.getCameraPosition() - P);
            	float ndv = clamp(abs(dot(N, V)), 0.0, 1.0);
            	float rim = pow(1.0 - ndv, 2.5);
            	vec3 o = system.getSurfacePositionObjectSpace();
            	vec3 d = min(o - system.getAABBMinLocal(), system.getAABBMaxLocal() - o);
            	float second = max(min(d.x, d.y), min(max(d.x, d.y), d.z));
            	float edge = 1.0 - smoothstep(0.12, 0.42, second);
            	float glow = clamp(0.16 + 0.7 * rim + 0.8 * edge, 0.0, 1.0);
            	result = vec4(tint.rgb * (0.78 + 0.22 * glow), tint.a * glow);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Ghost Fresnel
        UseExternalFile:
          Variable: false
        tint:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
      PositionY: 91
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Ghost Fresnel
