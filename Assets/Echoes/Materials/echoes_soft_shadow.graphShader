    Node1:
      DependencyIndex: 1
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 tint;
            output_vec4 result;
            
            // Echoes soft contact shadow: flat quad, solid core, smooth falloff to the edges (UV 0..1).
            void main()
            {
            	vec2 uv = system.getSurfaceUVCoord0();
            	vec2 q = abs(uv - 0.5) * 2.0;
            	float r = length(max(q - vec2(0.42), vec2(0.0))) / 0.58;
            	float a = 1.0 - smoothstep(0.0, 1.0, clamp(r, 0.0, 1.0));
            	result = vec4(tint.rgb, tint.a * a * a);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Soft Shadow
        UseExternalFile:
          Variable: false
        tint:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
